<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_sim2d</name>
  <version>0.1.0</version>
  <description>
    Top-down 2D sim of the Go2 in the go2_scenarios worlds. Kinematic robot
    with the robot's ROS interface (sport API, /utlidar/robot_odom), and
    fake_perception, which publishes the noisy leader and obstacles
    (follow_anywhere_interfaces) in place of the perception stack.
  </description>
  <maintainer email="jens1906@gmail.com">jens</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>unitree_api</depend>
  <depend>unitree_go</depend>
  <depend>follow_anywhere_interfaces</depend>
  <depend>go2_scenarios</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyqtgraph</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
