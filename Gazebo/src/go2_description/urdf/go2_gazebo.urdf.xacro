<?xml version="1.0"?>
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================================================
    Include the official Unitree Go2 URDF from vendored upstream repo.
    Source: https://github.com/unitreerobotics/unitree_ros
            robots/go2_description/urdf/go2_description.urdf

    Root body link:  "base"
    Existing sensor links already in this URDF (reused below):
      - "imu"          at xyz="-0.02557 0 0.04232" from base
      - "radar"        at xyz="0.28945 0 -0.046825" rpy="0 2.8782 0" from base
      - "front_camera" at xyz="0.32715 -0.00003 0.04297" from base
    Mesh URIs: package://go2_description/dae/*.dae (installed by CMakeLists)
  ========================================================= -->
  <xacro:include filename="$(find go2_description)/urdf/upstream/go2_description.urdf"/>


  <!-- =========================================================
    Additional camera link frames (children of "base").
    Positions are approximate based on physical Go2 geometry —
    verify against official CAD if precise sensor alignment matters.
  ========================================================= -->

  <link name="left_camera_link"/>
  <joint name="left_camera_joint" type="fixed">
    <parent link="base"/>
    <child link="left_camera_link"/>
    <!-- Left side of body, facing left -->
    <origin xyz="0.02 0.085 0.0" rpy="0 0 1.5708"/>
  </joint>

  <link name="right_camera_link"/>
  <joint name="right_camera_joint" type="fixed">
    <parent link="base"/>
    <child link="right_camera_link"/>
    <!-- Right side of body, facing right -->
    <origin xyz="0.02 -0.085 0.0" rpy="0 0 -1.5708"/>
  </joint>

  <link name="rear_camera_link"/>
  <joint name="rear_camera_joint" type="fixed">
    <parent link="base"/>
    <child link="rear_camera_link"/>
    <!-- Rear of body, facing backward -->
    <origin xyz="-0.18 0.0 0.0" rpy="0 0 3.14159"/>
  </joint>

  <link name="chin_camera_link"/>
  <joint name="chin_camera_joint" type="fixed">
    <parent link="base"/>
    <child link="chin_camera_link"/>
    <!-- Under-chin, tilted slightly downward -->
    <origin xyz="0.20 0.0 -0.06" rpy="0 0.4 0"/>
  </joint>

  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base"/>
    <child link="lidar_link"/>
    <!-- Top of body (Hesai XT16) -->
    <origin xyz="0.0 0.0 0.105" rpy="0 0 0"/>
  </joint>

  <link name="fisheye_camera_link"/>
  <joint name="fisheye_camera_joint" type="fixed">
    <parent link="base"/>
    <child link="fisheye_camera_link"/>
    <!-- Top-front, wide-angle overview -->
    <origin xyz="0.0 0.0 0.08" rpy="0 0 0"/>
  </joint>


  <!-- =========================================================
    MODEL-LEVEL GAZEBO PLUGINS
    A bare <gazebo> tag (no reference=) applies to the whole model.
  ========================================================= -->
  <gazebo>
    <!-- gz-sim-sensors-system: required for gpu_lidar, rgbd_camera,
         wideanglecamera. Uses ogre2 renderer (GPU required).
         For CPU-only machines: change ogre2 to ogre. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- gz-sim-imu-system: required for imu sensor type -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- JointStatePublisher: publishes joint states as gz.msgs.Model on
         /world/go2_world/model/go2/joint_state (bridged to /joint_states) -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <!-- gz_ros2_control: connects ros2_control controllers to Gazebo physics -->
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find go2_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>


  <!-- =========================================================
    ros2_control HARDWARE INTERFACE
    CHAMP outputs position targets via JointTrajectoryController.
    All 12 actuated joints declared with position command + state.
  ========================================================= -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Front Right leg -->
    <joint name="FR_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FR_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FR_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Front Left leg -->
    <joint name="FL_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FL_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FL_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Rear Right leg -->
    <joint name="RR_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RR_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RR_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Rear Left leg -->
    <joint name="RL_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RL_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RL_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>


  <!-- =========================================================
    PER-LINK GAZEBO SENSORS
  ========================================================= -->

  <!-- IMU — reuses "imu" link from upstream URDF -->
  <gazebo reference="imu">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/imu/data</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Hesai XT16 LiDAR — 16 beams, 360°, ±15° vertical, 10 Hz -->
  <gazebo reference="lidar_link">
    <sensor name="hesai_xt16" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/utlidar/cloud_gz</topic>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1800</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.26180</min_angle>
            <max_angle>0.26180</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Front depth camera (RealSense equivalent) — reuses "front_camera" link -->
  <gazebo reference="front_camera">
    <sensor name="front_rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/front_camera_gz</topic>
      <camera>
        <horizontal_fov>1.2043</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <output>depths</output>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- Left depth camera -->
  <gazebo reference="left_camera_link">
    <sensor name="left_rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/left_camera_gz</topic>
      <camera>
        <horizontal_fov>1.2043</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip><near>0.1</near><far>10.0</far></clip>
        <depth_camera>
          <clip><near>0.1</near><far>10.0</far></clip>
          <output>depths</output>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- Right depth camera -->
  <gazebo reference="right_camera_link">
    <sensor name="right_rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/right_camera_gz</topic>
      <camera>
        <horizontal_fov>1.2043</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip><near>0.1</near><far>10.0</far></clip>
        <depth_camera>
          <clip><near>0.1</near><far>10.0</far></clip>
          <output>depths</output>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- Chin camera (slightly downward) -->
  <gazebo reference="chin_camera_link">
    <sensor name="chin_rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/chin_camera_gz</topic>
      <camera>
        <horizontal_fov>1.2043</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip><near>0.05</near><far>5.0</far></clip>
        <depth_camera>
          <clip><near>0.05</near><far>5.0</far></clip>
          <output>depths</output>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- Rear depth camera -->
  <gazebo reference="rear_camera_link">
    <sensor name="rear_rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/rear_camera_gz</topic>
      <camera>
        <horizontal_fov>1.2043</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip><near>0.1</near><far>10.0</far></clip>
        <depth_camera>
          <clip><near>0.1</near><far>10.0</far></clip>
          <output>depths</output>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- Fisheye camera (180° wide-angle, top mounted) -->
  <gazebo reference="fisheye_camera_link">
    <sensor name="fisheye_cam" type="wideanglecamera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/fisheye_camera_gz</topic>
      <camera>
        <horizontal_fov>3.14159</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>RGB_INT8</format>
        </image>
        <clip><near>0.01</near><far>30.0</far></clip>
        <lens>
          <type>equidistant</type>
          <scale_to_hfov>true</scale_to_hfov>
        </lens>
      </camera>
    </sensor>
  </gazebo>

</robot>
