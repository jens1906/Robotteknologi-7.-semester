<?xml version="1.0"?>
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================================================
    Include the official Unitree Go2 URDF from vendored upstream repo.
    Source: https://github.com/unitreerobotics/unitree_ros
            robots/go2_description/urdf/go2_description.urdf

    Root body link: "base". Reused upstream links:
      - "imu"          body IMU (feeds /lowstate, /sportmodestate)
      - "front_camera" head camera (feeds /frontvideostream)
    Mesh URIs: package://go2_description/dae/*.dae (installed by CMakeLists)

    The sensor set matches the physical Go2 in the recorded bag
    go2_all_topics_6_10_11_28, plus the RealSense D455 mounted on it:
      Unitree L1 lidar + its IMU, head camera, body IMU, D455.
  ========================================================= -->
  <xacro:include filename="$(find go2_description)/urdf/upstream/go2_description.urdf"/>

  <!-- Sensor mounts relative to base_link, shared with go2_bringup's static TF -->
  <xacro:property name="mounts" value="${xacro.load_yaml('$(find go2_bringup)/config/go2_mounts.yaml')}"/>

  <xacro:macro name="mount" params="name">
    <link name="${name}"/>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${' '.join(str(v) for v in mounts[name]['xyz'])}"
              rpy="${' '.join(str(v) for v in mounts[name]['rpy'])}"/>
    </joint>
  </xacro:macro>

  <!-- D455 render settings (the real camera's ROS defaults are 848x480 @ 30 Hz) -->
  <xacro:property name="rs_width" value="848"/>
  <xacro:property name="rs_height" value="480"/>
  <xacro:property name="rs_rate" value="30"/>


  <!-- =========================================================
    Frames with the names the real robot uses in its messages.
    base_link is the body frame of /utlidar/robot_odom and /utlidar/cloud_base.
  ========================================================= -->
  <link name="base_link"/>
  <joint name="base_link_joint" type="fixed">
    <parent link="base"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:mount name="utlidar_lidar"/>
  <xacro:mount name="utlidar_imu"/>
  <xacro:mount name="camera_link"/>

  <!-- realsense2_camera optical frames (z forward, x right, y down) -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>


  <!-- =========================================================
    MODEL-LEVEL GAZEBO PLUGINS
    A bare <gazebo> tag (no reference=) applies to the whole model.
  ========================================================= -->
  <gazebo>
    <!-- gz-sim-sensors-system: required for gpu_lidar, rgbd_camera, camera.
         Uses ogre2 renderer. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- gz-sim-imu-system: required for imu sensor type -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- JointStatePublisher: publishes joint states as gz.msgs.Model on
         /world/go2_world/model/go2/joint_state (bridged to /joint_states) -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <!-- Ground-truth odometry of the body, the source for /utlidar/robot_odom
         and /sportmodestate. Its TF goes to an unbridged gz topic: the real
         robot publishes no /tf. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>200</odom_publish_frequency>
      <odom_topic>/model/go2/odometry</odom_topic>
      <tf_topic>/model/go2/odometry_tf</tf_topic>
      <dimensions>3</dimensions>
    </plugin>

    <!-- gz_ros2_control: connects ros2_control controllers to Gazebo physics -->
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find go2_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>


  <!-- =========================================================
    ros2_control HARDWARE INTERFACE
    CHAMP outputs position targets via JointTrajectoryController.
    All 12 actuated joints declared with position command + state.
  ========================================================= -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Front Right leg -->
    <joint name="FR_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FR_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FR_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Front Left leg -->
    <joint name="FL_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FL_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FL_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Rear Right leg -->
    <joint name="RR_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RR_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RR_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Rear Left leg -->
    <joint name="RL_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RL_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RL_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>


  <!-- =========================================================
    PER-LINK GAZEBO SENSORS
    Raw gz topics end in _gz; go2_robot_emulator turns them into the
    real robot's topics, frames, rates and message layouts.
  ========================================================= -->

  <!-- Body IMU — reuses "imu" link from upstream URDF -->
  <gazebo reference="imu">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>500</update_rate>
      <topic>/imu_gz</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Unitree L1 lidar IMU (/utlidar/imu, ~250 Hz on the robot) -->
  <gazebo reference="utlidar_imu">
    <sensor name="utlidar_imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>250</update_rate>
      <topic>/utlidar/imu_gz</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Unitree L1 lidar: hemispherical, 360 deg around its z axis and 0-90 deg
       elevation, ~15 frames/s. The robot sends ~4150 points per frame from a
       non-repetitive pattern; the emulator subsamples this dense grid to match. -->
  <gazebo reference="utlidar_lidar">
    <sensor name="utlidar_l1" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/utlidar/raw_gz</topic>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>45</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>1.5707963</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Head camera (/frontvideostream). The robot encodes every 15 Hz frame as
       1280x720 and 640x360 H.264; the emulator encodes both from this image. -->
  <gazebo reference="front_camera">
    <sensor name="head_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/head_camera_gz</topic>
      <camera>
        <horizontal_fov>2.0</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>50.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- RealSense D455: depth FOV 87 x 58 deg, ideal depth range 0.6-6 m -->
  <gazebo reference="camera_link">
    <sensor name="d455" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>${rs_rate}</update_rate>
      <topic>/d455_gz</topic>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>${rs_width}</width>
          <height>${rs_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>20.0</far></clip>
        <depth_camera>
          <clip><near>0.4</near><far>6.0</far></clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
