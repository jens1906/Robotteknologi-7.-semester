<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_bringup</name>
  <version>0.0.0</version>
  <description>TF for the Go2: sensor mounts and odom -> base_link. Used unchanged on the real robot and in the Gazebo sim, since neither publishes /tf.</description>
  <maintainer email="jens1906@gmail.com">jens</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
