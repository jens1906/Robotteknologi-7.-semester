<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_interface</name>
  <version>0.0.0</version>
  <description>Viewer for perception: compressed camera feed with the tracked people and the leader drawn on it; click a person to calibrate the leader.</description>
  <maintainer email="jens1906@gmail.com">jens</maintainer>
  <license>TODO: License declaration</license>

  <!-- Runs on the laptop, not on the robot. Nothing depends on this package.
       Only the compressed image comes over the network (sensor_msgs/CompressedImage, decoded with OpenCV),
       so no image_transport plugin is needed here. -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>follow_anywhere_interfaces</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
