<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_verify</name>
  <version>0.0.0</version>
  <description>Live dashboard (cameras, lidar, state charts, topic rates) to visually verify the Go2's data</description>
  <maintainer email="jens1906@gmail.com">jens</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>unitree_go</depend>
  <depend>unitree_api</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- pyqtgraph, PyOpenGL and av: see requirements.txt (not all are rosdep keys) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyqtgraph</exec_depend>
  <exec_depend>python3-opengl</exec_depend>
  <exec_depend>ffmpeg</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
