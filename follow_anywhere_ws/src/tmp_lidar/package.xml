<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tmp_lidar</name>
  <version>0.0.0</version>
  <description>Lidar part of perception: obstacle clusters from /utlidar/cloud_base, fused with the camera's leader and people (enrichment + deduplication)</description>
  <maintainer email="marrinusw@gmail.com">The Lonesome Programmer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>follow_anywhere_interfaces</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>perception</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
