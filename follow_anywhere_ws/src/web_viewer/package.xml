<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>web_viewer</name>
  <version>0.0.0</version>
  <description>C++ web server that streams any topic, lidar point clouds and camera images to a browser over WebSockets</description>
  <maintainer email="marrinusw@gmail.com">marrinus</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>follow_anywhere_interfaces</depend>
  <depend>ament_index_cpp</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>boost</depend>
  <depend>libopencv-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
